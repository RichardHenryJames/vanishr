{
  "about": "Cases for the rules of the over-the-air settings. Each source is what an owner would put in ota/settings.source.json (features, notice, update). 'signer' says whether scripts/ota-settings-rules.ps1 accepts it, 'app' whether RemoteSettings.java accepts the same fields in a correctly signed file. They differ only where the app is deliberately more relaxed: it skips switches and fields it does not know, the signer refuses them as typing mistakes. The signer must never accept what the app refuses. Run by scripts/test-ota-settings.ps1 and by RemoteSettingsTest. ASCII only, so that every character that matters is visible here as an escape.",
  "cases": [
    { "name": "nothing at all", "source": {}, "signer": true, "app": true },
    { "name": "empty features", "source": { "features": {} }, "signer": true, "app": true },
    { "name": "all three switched off", "source": { "features": { "images": false, "photos": false, "groups": false } }, "signer": true, "app": true },
    { "name": "all three explicitly on", "source": { "features": { "images": true, "photos": true, "groups": true } }, "signer": true, "app": true },
    { "name": "a switch given as text", "source": { "features": { "images": "false" } }, "signer": false, "app": false },
    { "name": "a switch given as a number", "source": { "features": { "images": 0 } }, "signer": false, "app": false },
    { "name": "a switch given as null", "source": { "features": { "images": null } }, "signer": false, "app": false },
    { "name": "a switch the app does not have", "source": { "features": { "notAFeature": false } }, "signer": false, "app": true },
    { "name": "a switch named with the wrong case", "source": { "features": { "Images": false } }, "signer": false, "app": true },
    { "name": "features that is a list", "source": { "features": [] }, "signer": false, "app": false },
    { "name": "features that is text", "source": { "features": "off" }, "signer": false, "app": false },
    { "name": "an unknown top-level field", "source": { "extra": 1 }, "signer": false, "app": true },

