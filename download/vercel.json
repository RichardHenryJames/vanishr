{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "buildCommand": null,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {"key": "Content-Security-Policy", "value": "default-src 'none'; style-src 'self'; img-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"},
        {"key": "X-Content-Type-Options", "value": "nosniff"},
        {"key": "Referrer-Policy", "value": "no-referrer"},
        {"key": "X-Robots-Tag", "value": "noindex, nofollow"}
      ]
    },
    {
      "source": "/vanishr-0.2.7.apk",
      "headers": [
        {"key": "Content-Type", "value": "application/vnd.android.package-archive"},
        {"key": "Content-Disposition", "value": "attachment; filename=vanishr-0.2.7.apk"},
        {"key": "Cache-Control", "value": "public, max-age=3600, must-revalidate"}
      ]
    },
    {
      "source": "/(.*).txt",
      "headers": [{"key": "Content-Type", "value": "text/plain; charset=utf-8"}]
    },
    {
      "source": "/updates.json",
      "headers": [
        {"key": "Content-Type", "value": "application/json; charset=utf-8"},
        {"key": "Cache-Control", "value": "no-store"}
      ]
    }
  ]
}